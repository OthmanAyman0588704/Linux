
```python
import requests
from datetime import datetime

# URL der API für die Uhrzeit von Berlin
berlin_time_url = "http://worldtimeapi.org/api/timezone/ Europe/Berlin"
tokio_time_url = "http://worldtimeapi.org/api/timezone/Asia/Tokyo"

def get_current_time(url):
    try:
        response = requests.get(url)
        response.raise_for_status()  # Überprüfe, ob die Anfrage erfolgreich war
        time_data = response.json()
        return datetime.strptime(time_data['datetime'], '%Y-%m-%dT%H:%M:%S')
    except requests.RequestException as e:
        print(f"An error occurred while fetching the time: {e}")
        return None

berlin_time = get_current_time(berlin_time_url)
tokio_time = get_current_time(tokio_time_url)

if berlin_time and tokio_time:
    print("Berlin Uhrzeit:", berlin_time.strftime('%Y-%m-%d %H:%M:%S'))
    print("Tokyo Uhrzeit:", tokio_time.strftime('%Y-%m-%d %H:%M:%S'))
else:
    print("Fehler beim Abruf der Zeit.")
```
